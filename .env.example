DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email — SMTP over SSL to the medi-finance.co.uk mail server.
# Set EMAIL_HOST_PASSWORD to send for real; leave it blank and emails print to
# the terminal (console backend) instead of attempting SMTP auth.
EMAIL_HOST=mail.medi-finance.co.uk
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=info@medi-finance.co.uk
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Medifinance <info@medi-finance.co.uk>
# Reply-To on all outgoing mail — the no-hyphen domain, unlike the sender.
EMAIL_REPLY_TO=info@medifinance.co.uk
# Two-factor authentication (authenticator-app codes). Comma-separated roles
# that MUST use it: admin, associate, customer — or "all". Listed roles are
# forced to enrol at their next sign-in and asked for a code on every login.
# Leave empty and nobody is forced (users can still opt in via Security).
TWO_FACTOR_REQUIRED_ROLES=admin
# Label shown in the authenticator app (default "Medifinance CRM").
#TWO_FACTOR_ISSUER=Medifinance CRM (dev)

# Comma-separated; notified when a deal is created via the public API.
NOTIFY_EMAILS=mnthurling@gmail.com

# Seconds a repeat POST /api/deals/ (same introducer + customer email) returns
# the existing deal instead of creating a new one. Default 86400 (24h); the
# dev deploy sets 10 so repeated demo submissions create real deals.
API_DEAL_DEDUP_SECONDS=86400
# Per-key rolling limits on new (non-dedup'd) deals via POST /api/deals/.
# Defaults 5/25; the dev deploy sets 500/2500 for demos.
API_DEAL_RATE_LIMIT_HOUR=5
API_DEAL_RATE_LIMIT_DAY=25
# New API deals per applicant email per hour, across all partner keys.
API_DEAL_EMAIL_RATE_LIMIT_HOUR=3
# Amount bounds for POST /api/deals/ (GBP). Outside them -> 422.
API_DEAL_MIN_AMOUNT=1000
API_DEAL_MAX_AMOUNT=10000000
# How long a successful response is replayed for a repeat Idempotency-Key.
API_IDEMPOTENCY_SECONDS=86400

# Xero — developer-app credentials (from developer.xero.com).
# Without these the Xero status page renders a 'not configured' warning.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# DocuSeal — self-hosted e-signature instance. Locally:
#   docker run -d --name docuseal -p 3000:3000 -v ~/.docuseal:/data docuseal/docuseal
# then copy the API token from its UI (Settings → API). Leave unset and the
# send-for-signature feature stays hidden.
DOCUSEAL_URL=
DOCUSEAL_API_TOKEN=
DOCUSEAL_WEBHOOK_SECRET=

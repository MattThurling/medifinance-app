DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email — SMTP over SSL to the medi-finance.co.uk mail server.
# Set EMAIL_HOST_PASSWORD to send for real; leave it blank and emails print to
# the terminal (console backend) instead of attempting SMTP auth.
EMAIL_HOST=mail.medi-finance.co.uk
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=info@medi-finance.co.uk
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Medifinance <info@medi-finance.co.uk>
# Comma-separated; notified when a deal is created via the public API.
NOTIFY_EMAILS=mnthurling@gmail.com

# Seconds a repeat POST /api/deals/ (same introducer + customer email) returns
# the existing deal instead of creating a new one. Default 86400 (24h); the
# dev deploy sets 10 so repeated demo submissions create real deals.
API_DEAL_DEDUP_SECONDS=86400
# Per-key rolling limits on new (non-dedup'd) deals via POST /api/deals/.
# Defaults 5/25; the dev deploy sets 500/2500 for demos.
API_DEAL_RATE_LIMIT_HOUR=5
API_DEAL_RATE_LIMIT_DAY=25

# Xero — developer-app credentials (from developer.xero.com).
# Without these the Xero status page renders a 'not configured' warning.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

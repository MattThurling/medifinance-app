DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Email (Mailgun via django-anymail).
# Leave MAILGUN_API_KEY blank in dev — emails print to the console instead of sending.
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=mg.medifinance.co.uk
# EU region default; for US use https://api.mailgun.net/v3
MAILGUN_API_URL=https://api.eu.mailgun.net/v3
DEFAULT_FROM_EMAIL=Medifinance <noreply@mg.medifinance.co.uk>
